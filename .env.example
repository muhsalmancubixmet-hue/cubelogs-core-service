# Django Core Settings
ENVIRONMENT=development
DJANGO_SECRET_KEY=change-this-in-production-use-a-secure-random-50-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata
# SECURE_SSL_REDIRECT=True  # Automatically True when ENVIRONMENT=production

# CORS & Frontend URLs
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Active: SQLite (for local dev or temporary PythonAnywhere staging)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_CONN_MAX_AGE=0
ALLOW_SQLITE_IN_PRODUCTION=True

# Production PostgreSQL (uncomment and fill on production server; set ALLOW_SQLITE_IN_PRODUCTION=False):
# Set DB_CONN_MAX_AGE=0 if behind PgBouncer in transaction pooling mode; otherwise 60 is recommended.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cubelogs_db
# DB_USER=cubelogs_user
# DB_PASSWORD=change-me-strong-db-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_MS=30000
# Alternative single-URL format:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Storage Paths (Optional overrides for production persistent/shared mounts)
# STATIC_ROOT=/var/www/cubelogs/staticfiles
# MEDIA_ROOT=/var/www/cubelogs/media
# PRIVATE_MEDIA_ROOT=/var/www/cubelogs/private_media

# Redis & Celery Task Queue
# Active: single-node / eager mode (no external Redis server required)
REDIS_URL=
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=True

# Production Redis & Celery (uncomment on production server with Redis):
# REDIS_URL=redis://127.0.0.1:6379/2
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# CELERY_TASK_ALWAYS_EAGER=False

# JWT Authentication Token Configuration
# Set JWT_ACCESS_MINUTES for short-lived tokens (e.g. 30), or use JWT_ACCESS_DAYS
JWT_ACCESS_DAYS=7
JWT_REFRESH_DAYS=60
ROTATE_REFRESH_TOKENS=False
BLACKLIST_AFTER_ROTATION=False

# Email SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=CubeLogs <your-email@gmail.com>

# Razorpay Payment Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=False

# Product Details
SUPPORT_EMAIL=support@cubelogs.com
COMPANY_NAME=CubeLogs Inc.
COMPANY_WEBSITE=https://cubelogs.com
