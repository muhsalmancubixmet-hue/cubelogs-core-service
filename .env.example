# Environment Flag
# development -> automatically uses SQLite + in-memory Celery/Cache
# production  -> automatically uses PostgreSQL + Redis + production HTTPS security
ENVIRONMENT=development

# Django Core Settings
DJANGO_SECRET_KEY=change-this-in-production-use-a-secure-random-50-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata
SECURE_SSL_REDIRECT=True

# CORS & Frontend URLs
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3000

# SQLite Database (used automatically when ENVIRONMENT=development)
SQLITE_DB_NAME=db.sqlite3

# PostgreSQL Database (used automatically when ENVIRONMENT=production)
# Set DB_CONN_MAX_AGE=0 if behind PgBouncer in transaction pooling mode; otherwise 60 is recommended.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cubelogs_db
DB_USER=cubelogs_user
DB_PASSWORD=change-me-strong-db-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# Storage Paths (Optional overrides for production persistent/shared mounts; leave blank for project defaults)
STATIC_ROOT=
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=

# Redis & Celery Task Queue (used automatically when ENVIRONMENT=production; set USE_REDIS_IN_DEV=True to test in dev)
USE_REDIS_IN_DEV=False
REDIS_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# JWT Authentication Token Configuration
JWT_ACCESS_DAYS=7
JWT_REFRESH_DAYS=60
ROTATE_REFRESH_TOKENS=False
BLACKLIST_AFTER_ROTATION=False

# Email SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=CubeLogs <your-email@gmail.com>

# Razorpay Payment Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=False

# Product Details
SUPPORT_EMAIL=support@cubelogs.com
COMPANY_NAME=CubeLogs Inc.
COMPANY_WEBSITE=https://cubelogs.com
